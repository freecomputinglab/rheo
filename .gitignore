# Nix build artifacts
result
result-*

# Beads runtime/ephemeral files — everything is per-machine state except
# open.jsonl, the shared export of open/in-progress issues. Order matters: a
# negation cannot re-enter a directory excluded as a directory.
!/.beads/
/.beads/*
!/.beads/open.jsonl
.abacus/

# Claude
.claude/

# Per-project build directories
**/build/

# Cargo build artifacts
/target

.rustfmt.toml

# Test store (generated test outputs)
/tests/store/
# br doctor per-run artifacts
.doctor/
